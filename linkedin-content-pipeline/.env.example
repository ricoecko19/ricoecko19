# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is a placeholder. No real identifier belongs in this file.
#
# The publishing secrets in the second block are NOT read from .env in production.
# They live in the CI provider's encrypted secret store and are injected into the
# job environment at run time. They are listed here so the names are documented and
# so the publisher can be run locally against a test organization.

# ---------------------------------------------------------------------------
# Design tool
# ---------------------------------------------------------------------------
# The proven eight-page carousel that every new carousel is copied from.
TEMPLATE_DESIGN_ID=XXXXXXXXXXX

# Folder identifiers for the generation stages.
FOLDER_CONTENT=XXXXXXXXXXX
FOLDER_PENDING=XXXXXXXXXXX
FOLDER_VERIFIED=XXXXXXXXXXX

# ---------------------------------------------------------------------------
# Publishing — organization API (set as CI secrets, not in this file)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=XXXXXXXXXXX
LINKEDIN_CLIENT_SECRET=XXXXXXXXXXX

# Preferred: a refresh token, exchanged for an access token on every run.
# Requires the provider to have enabled programmatic refresh tokens for the app.
LINKEDIN_REFRESH_TOKEN=XXXXXXXXXXX

# Fallback: a long-lived access token (expires in 60 days). Used only when no
# refresh token is set. Expiry is a known operational hazard — see
# docs/how-to/recover-a-failed-run.md
LINKEDIN_ACCESS_TOKEN=

# The organization the post is authored by. This value is the author on every
# post; the publisher never accepts an author from the queue. Failsafe #1.
LINKEDIN_ORG_URN=urn:li:organization:000000000

# API version string, YYYYMM. Versions sunset on a published schedule; bump this
# yearly and before the current version's sunset date.
LINKEDIN_API_VERSION=202609

# ---------------------------------------------------------------------------
# Format limits imposed by the platform, not by us
# ---------------------------------------------------------------------------
DOC_TITLE_MAX_CHARS=68
CAPTION_MAX_CHARS=3000
CAROUSEL_PAGE_COUNT=8

# ---------------------------------------------------------------------------
# Schedule
# ---------------------------------------------------------------------------
# Generation runs both weekend days; the second run fills anything the first
# missed or aborted. Idempotent by design.
GENERATION_CRON="52 15 * * 6,0"

# Publishing fires twice each weekday in UTC; the publisher exits immediately on
# any run before the local cutoff, so exactly one lands near noon local time all
# year. See docs/how-to/change-the-schedule.md for why it is done this way.
PUBLISH_CRON_EARLY="50 18 * * 1-5"
PUBLISH_CRON_LATE="50 19 * * 1-5"
PUBLISH_LOCAL_CUTOFF="11:40"
POSTING_TIMEZONE="America/Los_Angeles"
POSTS_PER_WEEK=5

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
# Page identifier used for analytics routes. Admin routes require the numeric
# identifier; the vanity slug does not resolve.
PAGE_NUMERIC_ID=000000000

# Destination for the metrics log. Leave blank to write to the repository instead.
METRICS_SHEET_ID=
METRICS_SHEET_TAB=post_log

# Notification address for failed and aborted runs.
NOTIFY_EMAIL=you@example.org
