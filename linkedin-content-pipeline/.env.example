# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every value below is a placeholder. No real identifier belongs in this file.

# ---------------------------------------------------------------------------
# Design tool
# ---------------------------------------------------------------------------
# The proven eight-page carousel that every new carousel is copied from.
TEMPLATE_DESIGN_ID=XXXXXXXXXXX

# Folder identifiers for the approval stages.
FOLDER_CONTENT=XXXXXXXXXXX
FOLDER_PENDING=XXXXXXXXXXX
FOLDER_APPROVED=XXXXXXXXXXX

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------
# Display name of the company page, exactly as it appears in the author selector.
# The share dialog defaults to the personal profile; this is what it must be
# changed to. See docs/how-to/publish-an-approved-carousel.md
PUBLISH_AS_PAGE_NAME="Your Organization"

# Hard limits imposed by the platform, not by us. See docs/reference/configuration.md
DOC_TITLE_MAX_CHARS=68
CAPTION_MAX_CHARS=3000
CAROUSEL_PAGE_COUNT=8

# ---------------------------------------------------------------------------
# Schedule
# ---------------------------------------------------------------------------
# Generation run. Cron is evaluated in UTC; see the daylight-saving note in
# docs/how-to/change-the-schedule.md before editing.
GENERATION_CRON="0 16 * * 6"
POSTING_TIME_LOCAL="09:00"
POSTING_TIMEZONE="America/Los_Angeles"
POSTS_PER_WEEK=4

# Scheduled runs need a real browser, so they are bound to one machine.
PUBLISH_DEVICE_NAME="workstation-name"

# ---------------------------------------------------------------------------
# Not here on purpose
# ---------------------------------------------------------------------------
# No API keys, tokens, OAuth secrets, or passwords. Authorization to the design
# tool and to the social platform is held by the connector layer and granted
# interactively by a signed-in human. If you find yourself wanting to add a
# secret to this file, see docs/explanation/architecture.md#credentials
